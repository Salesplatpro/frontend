# API base URL.
#
# NOTE: this includes the `/v1` path segment. All endpoint paths defined in
# src/services/api/endpoints.ts and the existing RTK Query slices
# (src/redux/api/**) are written WITHOUT a leading `/v1`, since it is already
# part of this base URL.

# Local development (backend running on localhost:3003):
VITE_API_BASE_URL=

# Production:
# VITE_API_BASE_URL=https://api.auxhr.com/v1

# Canonical public origin, used to build links that leave the app: social
# share targets, copied job links and the og:url/canonical tags emitted by
# middleware.ts for crawlers.
#
# This must NOT be window.location.origin. Shared links are consumed by third
# parties, so a localhost or *.vercel.app origin produces a dead link — and a
# preview deployment sits behind deployment protection, so a crawler fetching
# it gets a 401 and renders no preview card at all.
#
# Vite inlines this at build time, so changing it requires a redeploy. Vercel
# also exposes it to Edge Middleware via process.env regardless of the VITE_
# prefix, which is how middleware.ts reads the same value.
VITE_PUBLIC_APP_URL=https://www.auxhr.com
